// collatz.c0 - Collatz conjecture (3n+1 problem)
// Compile: python3 c0c.py examples/collatz.c0
// Run:     ./c0vm examples/collatz.bc0

#use <conio>

int collatz_steps(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

int main() {
    println("Collatz steps to reach 1:");
    int n = 1;
    while (n <= 20) {
        print("  collatz(");
        printint(n);
        print(") = ");
        printint(collatz_steps(n));
        println(" steps");
        n = n + 1;
    }
    return 0;
}
